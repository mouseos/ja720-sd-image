#!/bin/sh
# JA720 Linux initramfs init
# - root filesystem is the initramfs itself (tmpfs-like ramfs)
# - network: USB gadget ethernet (g_ether), static 192.168.7.2/24
# - SSH: dropbear on port 22, user "root", password set in /etc/shadow
# - a local shell is also offered on the framebuffer console

/bin/busybox --install -s /bin

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts /run /tmp
mount -t devpts devpts /dev/pts

hostname ja720

echo
echo "==============================================="
echo " JA720 Linux (W55FA93) - dev image"
echo " kernel: $(uname -r)"
echo "==============================================="

# --- USB gadget ethernet: wait for usb0 to appear ---
ip link set lo up
n=0
while [ $n -lt 20 ]; do
	[ -d /sys/class/net/usb0 ] && break
	sleep 0.5
	n=$((n+1))
done
if [ -d /sys/class/net/usb0 ]; then
	ip addr add 192.168.7.2/24 dev usb0
	ip link set usb0 up
	echo "usb0: 192.168.7.2/24 - ssh root@192.168.7.2"
else
	echo "usb0: NOT FOUND (USB gadget not up - use console)"
fi

# --- SSH server ---
mkdir -p /etc/dropbear
[ -f /etc/dropbear/dropbear_ed25519_host_key ] || \
	dropbearkey -t ed25519 -f /etc/dropbear/dropbear_ed25519_host_key >/dev/null 2>&1
[ -f /etc/dropbear/dropbear_rsa_host_key ] || \
	dropbearkey -t rsa -s 2048 -f /etc/dropbear/dropbear_rsa_host_key >/dev/null 2>&1
dropbear -p 22 -B
echo "dropbear sshd started on port 22 (root / default password: ja720)"
echo "CHANGE THE PASSWORD with passwd after first login!"

# --- console shell on the framebuffer, sshd keeps running ---
exec setsid cttyhack sh
